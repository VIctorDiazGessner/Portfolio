---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";

const { email, linkedin, github } = siteConfig.social;
---

<section id="contact" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
  <div
    class="reveal max-w-6xl mx-auto rounded-2xl border border-[var(--border)] bg-[var(--bg-panel)] p-8 sm:p-14 text-center"
  >
    <p class="eyebrow">Get in touch</p>
    <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
      Let's build something.
    </h2>
    <p class="mt-4 text-[var(--text-muted)] max-w-lg mx-auto">
      Open to hardware, energy, and tech roles. The fastest way to reach me is
      email or LinkedIn.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {
        email && (
          <a
            href={`mailto:${email}`}
            class="px-5 py-2.5 rounded-md font-mono text-sm font-medium text-[#04121a] transition-transform hover:-translate-y-0.5"
            style={`background-color: ${siteConfig.accentColor}`}
          >
            {email}
          </a>
        )
      }
      <a
        href={withBase(siteConfig.resumeUrl)}
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-2.5 rounded-md font-mono text-sm border border-[var(--border-strong)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
      >
        Résumé ↓
      </a>
      {
        linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-md font-mono text-sm border border-[var(--border-strong)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
          >
            LinkedIn ↗
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-md font-mono text-sm border border-[var(--border-strong)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
          >
            GitHub ↗
          </a>
        )
      }
    </div>
  </div>
</section>
