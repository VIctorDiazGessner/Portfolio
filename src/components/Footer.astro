---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";

const year = 2026; // update as needed
const { email, linkedin, github } = siteConfig.social;
---

<footer class="border-t border-[var(--border)] px-5 sm:px-8 py-10">
  <div
    class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6"
  >
    <a
      href={withBase("/")}
      class="font-mono font-bold text-[var(--text)]"
      aria-label="Home"
    >
      <span style={`color: ${siteConfig.accentColor}`}>V</span>DG
    </a>

    <p class="font-mono text-xs text-[var(--text-faint)] order-3 sm:order-2">
      © {year} {siteConfig.name}
    </p>

    <div class="flex items-center gap-5 order-2 sm:order-3 text-[var(--text-muted)]">
      {
        email && (
          <a
            href={`mailto:${email}`}
            aria-label="Email"
            class="hover:text-[var(--accent)] transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
          </a>
        )
      }
      {
        linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="hover:text-[var(--accent)] transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </svg>
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="hover:text-[var(--accent)] transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</footer>
