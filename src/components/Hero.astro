---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center px-5 sm:px-8 pt-24 pb-16"
>
  <div
    class="max-w-6xl mx-auto w-full grid lg:grid-cols-12 gap-10 lg:gap-14 items-center"
  >
    <!-- Text column -->
    <div class="lg:col-span-7 order-2 lg:order-1">
      <p class="eyebrow hero-in" style="--d: 0ms">
        Mechanical Engineer · Product · Materials · Manufacturing
      </p>

      <h1
        class="hero-in mt-5 text-4xl sm:text-6xl lg:text-7xl font-bold leading-[1.02] text-[var(--text)]"
        style="--d: 90ms"
      >
        {siteConfig.name}
      </h1>

      <p
        class="hero-in mt-6 text-lg sm:text-2xl text-[var(--text-muted)] max-w-xl leading-snug"
        style="--d: 180ms"
      >
        {siteConfig.tagline}
      </p>

      <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--d: 270ms">
        <a
          href={withBase(siteConfig.resumeUrl)}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-md font-mono text-sm font-medium text-[#04121a] transition-transform hover:-translate-y-0.5"
          style={`background-color: ${siteConfig.accentColor}`}
        >
          Download Résumé ↓
        </a>
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-md font-mono text-sm border border-[var(--border-strong)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
        >
          LinkedIn ↗
        </a>
        <a
          href={withBase("/#work")}
          class="px-5 py-2.5 rounded-md font-mono text-sm text-[var(--text-muted)] hover:text-[var(--text)] transition-colors"
        >
          View work ↓
        </a>
      </div>
    </div>

    <!-- Photo column -->
    <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center lg:justify-end">
      <div class="hero-in w-full max-w-[320px]" style="--d: 160ms">
        {
          siteConfig.heroPhoto ? (
            <img
              src={withBase(siteConfig.heroPhoto)}
              alt={siteConfig.name}
              width="640"
              height="800"
              class="w-full aspect-[4/5] object-cover rounded-2xl border border-[var(--border)]"
            />
          ) : (
            <div
              class="w-full aspect-[4/5] rounded-2xl border border-dashed border-[var(--border-strong)] bg-[var(--bg-panel)] flex flex-col items-center justify-center text-center px-6 gap-3"
            >
              <svg
                class="w-10 h-10 text-[var(--text-faint)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <circle cx="12" cy="9" r="3.5" />
                <path d="M5 20a7 7 0 0 1 14 0" stroke-linecap="round" />
              </svg>
              <p class="font-mono text-xs text-[var(--text-faint)] leading-relaxed">
                PHOTO PLACEHOLDER
                <br />
                4:5 · warm, natural
                <br />
                <span style={`color: ${siteConfig.accentColor}`}>
                  set heroPhoto in config
                </span>
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- scroll hint -->
  <div
    class="hero-in absolute bottom-6 left-1/2 -translate-x-1/2 text-[var(--text-faint)]"
    style="--d: 500ms"
    aria-hidden="true"
  >
    <svg class="w-5 h-5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>

<style>
  .hero-in {
    opacity: 0;
    transform: translateY(16px);
    animation: heroIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
