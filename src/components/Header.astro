---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";

const nav = [
  { label: "Roles", href: withBase("/#roles") },
  { label: "Projects", href: withBase("/#work") },
  { label: "Experience", href: withBase("/#experience") },
  { label: "Skills", href: withBase("/#skills") },
  { label: "About", href: withBase("/#about") },
  { label: "Contact", href: withBase("/#contact") },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent"
>
  <nav
    class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-4"
  >
    <!-- Monogram / home -->
    <a
      href={withBase("/")}
      class="font-mono font-bold tracking-tight text-[var(--text)] hover:text-[var(--accent)] transition-colors"
      aria-label="Home"
    >
      <span style={`color: ${siteConfig.accentColor}`}>V</span>DG
    </a>

    <!-- Desktop nav -->
    <ul
      class="hidden md:flex items-center gap-7 text-sm font-mono text-[var(--text-muted)]"
    >
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="hover:text-[var(--text)] transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Resume CTA -->
    <a
      href={withBase(siteConfig.resumeUrl)}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-mono px-3.5 py-1.5 rounded-md border border-[var(--border-strong)] text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
    >
      Resume ↓
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add("bg-[#ffffff]/80", "backdrop-blur-md");
      header.style.borderBottomColor = "var(--border)";
    } else {
      header.classList.remove("bg-[#ffffff]/80", "backdrop-blur-md");
      header.style.borderBottomColor = "transparent";
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
