---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";

const experience = siteConfig.experience ?? [];
---

{
  experience.length > 0 && (
    <section id="experience" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="reveal mb-10 sm:mb-14">
          <p class="eyebrow">Career</p>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
            Experience
          </h2>
        </div>

        <ol class="relative border-l border-[var(--border)] ml-3 sm:ml-4">
          {experience.map((exp) => (
            <li class="reveal relative pl-8 sm:pl-10 pb-12 last:pb-0">
              {/* node */}
              <span
                class="absolute -left-[7px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-[var(--bg)]"
                style={`background-color: ${siteConfig.accentColor}`}
                aria-hidden="true"
              />

              <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-5 sm:p-6">
                <div class="flex items-start gap-4">
                  {/* logo chip */}
                  <div class="shrink-0 w-12 h-12 rounded-lg bg-white/95 flex items-center justify-center overflow-hidden p-1.5">
                    {exp.logo ? (
                      <img
                        src={withBase(exp.logo)}
                        alt={`${exp.company} logo`}
                        width="48"
                        height="48"
                        loading="lazy"
                        class="max-w-full max-h-full object-contain"
                      />
                    ) : (
                      <span class="font-mono font-bold text-sm text-[#0a0b0d]">
                        {exp.logoText}
                      </span>
                    )}
                  </div>

                  <div class="min-w-0 flex-1">
                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                      <h3 class="text-lg font-semibold text-[var(--text)]">
                        {exp.company}
                      </h3>
                      <span class="font-mono text-xs text-[var(--text-faint)] whitespace-nowrap">
                        {exp.dateRange}
                      </span>
                    </div>
                    <p
                      class="text-sm font-medium"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {exp.title}
                    </p>
                  </div>
                </div>

                <ul class="mt-4 space-y-2.5">
                  {exp.bullets.map((b) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed text-[var(--text-muted)]">
                      <span
                        class="mt-2 w-1.5 h-1.5 rounded-full shrink-0"
                        style={`background-color: ${siteConfig.accentColor}`}
                        aria-hidden="true"
                      />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
