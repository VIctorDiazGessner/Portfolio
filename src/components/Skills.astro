---
import { siteConfig } from "../config";

const groups = siteConfig.skillGroups ?? [];
const languages = siteConfig.languages ?? [];
const certifications = siteConfig.certifications ?? [];
const accent = siteConfig.accentColor;
---

{
  groups.length > 0 && (
    <section id="skills" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="reveal mb-10 sm:mb-14">
          <p class="eyebrow">Capabilities</p>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
            Skills
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
          {groups.map((group, i) => (
            <div
              class="reveal rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6"
              data-reveal-delay={String((i % 2) * 80)}
            >
              <div class="flex items-center gap-2.5 mb-4">
                <span
                  class="font-mono text-xs"
                  style={`color: ${siteConfig.accentColor}`}
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="font-mono text-sm uppercase tracking-widest text-[var(--text)]">
                  {group.category}
                </h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {group.skills.map((s) => (
                  <span class="text-sm px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-panel-2)] text-[var(--text-muted)]">
                    {s}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>

        {certifications.length > 0 && (
          <div class="reveal mt-5 flex flex-wrap items-center gap-3">
            <span class="font-mono text-xs uppercase tracking-widest text-[var(--text-faint)]">
              Certifications
            </span>
            {certifications.map((c) => (
              <span
                class="inline-flex items-center gap-2 text-sm font-medium px-3 py-1.5 rounded-md border bg-[var(--bg-panel)]"
                style={`border-color:${accent}55; color:${accent}`}
              >
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="8" r="6" />
                  <path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5" />
                </svg>
                {c.name}
              </span>
            ))}
          </div>
        )}

        {languages.length > 0 && (
          <div class="reveal mt-4 flex flex-wrap items-center gap-3">
            <span class="font-mono text-xs uppercase tracking-widest text-[var(--text-faint)]">
              Languages
            </span>
            {languages.map((l) => (
              <span class="text-sm text-[var(--text-muted)]">{l}</span>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
