---
import { siteConfig } from "../config";

const edu = siteConfig.education ?? [];
---

<section id="about" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="reveal mb-10 sm:mb-14">
      <p class="eyebrow">Profile</p>
      <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
        About
      </h2>
    </div>

    <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-start">
      <!-- Bio -->
      <div class="reveal lg:col-span-7">
        <p class="text-lg leading-relaxed text-[var(--text-muted)]">
          {siteConfig.aboutMe}
        </p>
      </div>

      <!-- Education -->
      {
        edu.length > 0 && (
          <div class="reveal lg:col-span-5" data-reveal-delay="80">
            {edu.map((e) => (
              <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6">
                <p class="eyebrow">Education</p>
                <h3 class="mt-3 text-lg font-semibold text-[var(--text)]">
                  {e.school}
                </h3>
                <p class="text-sm text-[var(--text-muted)]">{e.degree}</p>
                <p class="font-mono text-xs text-[var(--text-faint)] mt-1">
                  {e.dateRange}
                </p>
                <ul class="mt-4 space-y-2">
                  {e.achievements.map((a) => (
                    <li class="flex gap-2.5 text-sm text-[var(--text-muted)]">
                      <span
                        class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0"
                        style={`background-color: ${siteConfig.accentColor}`}
                        aria-hidden="true"
                      />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
