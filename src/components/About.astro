---
import { siteConfig } from "../config";

const edu = siteConfig.education ?? [];
const lead = siteConfig.leadership;
---

<section id="about" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
  <div class="max-w-6xl mx-auto">
    <div class="reveal mb-10 sm:mb-14">
      <p class="eyebrow">Profile</p>
      <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
        About
      </h2>
    </div>

    <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-start">
      <!-- Bio -->
      <div class="reveal lg:col-span-7">
        <p class="text-lg leading-relaxed text-[var(--text-muted)]">
          {siteConfig.aboutMe}
        </p>
      </div>

      <!-- Education -->
      {
        edu.length > 0 && (
          <div class="reveal lg:col-span-5" data-reveal-delay="80">
            {edu.map((e) => (
              <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6">
                <p class="eyebrow">Education</p>
                <h3 class="mt-3 text-lg font-semibold text-[var(--text)]">
                  {e.school}
                </h3>
                <p class="text-sm text-[var(--text-muted)]">{e.degree}</p>
                <p class="font-mono text-xs text-[var(--text-faint)] mt-1">
                  {e.dateRange}
                </p>
                <ul class="mt-4 space-y-2">
                  {e.achievements.map((a) => (
                    <li class="flex gap-2.5 text-sm text-[var(--text-muted)]">
                      <span
                        class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0"
                        style={`background-color: ${siteConfig.accentColor}`}
                        aria-hidden="true"
                      />
                      <span>{a}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <!-- Leadership: Engineer Forward (intentionally compact) -->
    {
      lead && (
        <div class="reveal mt-6 rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6 sm:p-8 relative overflow-hidden">
          <div
            class="absolute left-0 top-0 bottom-0 w-1"
            style={`background-color: ${siteConfig.accentColor}`}
            aria-hidden="true"
          />
          <div class="grid sm:grid-cols-12 gap-6 items-start">
            <div class="sm:col-span-8">
              <p class="eyebrow">Leadership</p>
              <h3 class="mt-3 text-xl font-semibold text-[var(--text)]">
                {lead.org}
                <span class="text-[var(--text-muted)] font-normal text-base">
                  {" "}· {lead.role}
                </span>
              </h3>
              <p class="mt-3 text-[15px] leading-relaxed text-[var(--text-muted)]">
                {lead.summary}
              </p>
            </div>
            <div class="sm:col-span-4 flex sm:justify-end gap-8">
              {lead.stats.map((s) => (
                <div>
                  <div
                    class="font-mono text-3xl font-bold"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {s.value}
                  </div>
                  <div class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
                    {s.label}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
