---
import { siteConfig } from "../config";

const coursework = siteConfig.coursework ?? [];
const ventures = siteConfig.ventures ?? [];
const accent = siteConfig.accentColor;
const hasAny = coursework.length > 0 || ventures.length > 0;
---

{
  hasAny && (
    <section id="more" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="reveal mb-10 sm:mb-14">
          <p class="eyebrow">Also</p>
          <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
            Coursework &amp; Ventures
          </h2>
        </div>

        {/* CFD coursework */}
        {coursework.length > 0 && (
          <div class="reveal">
            <h3 class="font-mono text-sm uppercase tracking-widest text-[var(--text-faint)]">
              CFD Coursework
            </h3>
            {siteConfig.courseworkNote && (
              <p class="font-mono text-xs text-[var(--text-faint)] mb-4 mt-1">
                {siteConfig.courseworkNote}
              </p>
            )}
            <div class="grid sm:grid-cols-2 gap-4">
              {coursework.map((c) => (
                <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-5">
                  <div class="flex items-center justify-between gap-3">
                    <h4 class="text-base font-semibold text-[var(--text)]">
                      {c.title}
                    </h4>
                    <span
                      class="font-mono text-[10px] uppercase tracking-wider px-2 py-1 rounded border shrink-0"
                      style={`color:${accent}; border-color:${accent}55`}
                    >
                      {c.tool}
                    </span>
                  </div>
                  <p class="mt-3 text-sm text-[var(--text-muted)] leading-relaxed">
                    {c.blurb}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {c.tags.map((t) => (
                      <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[var(--bg-panel-2)] text-[var(--text-muted)]">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Ventures */}
        {ventures.length > 0 && (
          <div class="reveal mt-10">
            <h3 class="font-mono text-sm uppercase tracking-widest text-[var(--text-faint)] mb-4">
              Ventures
            </h3>
            <div class="grid gap-4">
              {ventures.map((v) => (
                <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6">
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                    <h4 class="text-lg font-semibold text-[var(--text)]">
                      {v.name}
                      <span class="text-[var(--text-muted)] font-normal text-sm">
                        {" "}· {v.role}
                      </span>
                    </h4>
                    <span class="font-mono text-xs text-[var(--text-faint)] whitespace-nowrap">
                      {v.dateRange}
                    </span>
                  </div>
                  <p class="mt-3 text-sm text-[var(--text-muted)] leading-relaxed">
                    {v.blurb}
                  </p>
                  <p class="mt-3 text-sm text-[var(--text)] leading-relaxed">
                    {v.contribution}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {v.tags.map((t) => (
                      <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-[var(--bg-panel-2)] text-[var(--text-muted)]">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}
