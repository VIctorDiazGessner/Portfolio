---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";
import type { Project } from "../config";

interface Props {
  project: Project;
  index: number; // 0-based, for the display number and stagger
}
const { project, index } = Astro.props;
const accent = siteConfig.accentColor;
---

<a
  href={withBase(`/projects/${project.slug}`)}
  class="reveal group relative flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6 sm:p-7 transition-all duration-300 hover:border-[var(--border-strong)] hover:-translate-y-1"
  data-reveal-delay={String((index % 2) * 80)}
>
  <div class="flex items-center justify-between">
    <span class="font-mono text-sm" style={`color: ${accent}`}>
      {String(index + 1).padStart(2, "0")}
    </span>
    <span class="font-mono text-xs uppercase tracking-widest text-[var(--text-faint)]">
      {project.org}
    </span>
  </div>

  <h3 class="mt-4 text-xl sm:text-2xl font-semibold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
    {project.name}
  </h3>

  <p class="mt-3 text-[15px] leading-relaxed text-[var(--text-muted)] flex-1">
    {project.summary}
  </p>

  {
    project.metrics?.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
        {project.metrics.map((m) => (
          <div>
            <div class="font-mono text-lg font-bold" style={`color: ${accent}`}>
              {m.value}
            </div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
              {m.label}
            </div>
          </div>
        ))}
      </div>
    )
  }

  <div class="mt-6 flex items-center justify-between border-t border-[var(--border)] pt-4">
    <div class="flex flex-wrap gap-1.5">
      {project.skills.slice(0, 3).map((s) => (
        <span class="font-mono text-[11px] px-2 py-1 rounded bg-[var(--bg-panel-2)] text-[var(--text-muted)]">
          {s}
        </span>
      ))}
    </div>
    <span class="flex items-center gap-1.5 font-mono text-xs text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors whitespace-nowrap">
      {project.reportUrl && "PDF · "}View project
      <svg
        class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M7 17L17 7M17 7H7M17 7v10"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </div>
</a>
