---
import { siteConfig } from "../config";
import { withBase } from "../lib/base";
import ProjectCard from "./ProjectCard.astro";

const projects = siteConfig.projects ?? [];
const ansysProjects = siteConfig.ansysProjects ?? [];
const accent = siteConfig.accentColor;
---

{
  projects.length > 0 && (
    <section id="work" class="scroll-mt-20 px-5 sm:px-8 py-20 sm:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="reveal flex items-end justify-between gap-4 mb-10 sm:mb-14">
          <div>
            <p class="eyebrow">Selected Work</p>
            <h2 class="mt-3 text-3xl sm:text-5xl font-bold text-[var(--text)]">
              Engineering Projects
            </h2>
          </div>
          <span class="hidden sm:block font-mono text-sm text-[var(--text-faint)]">
            {String(projects.length).padStart(2, "0")} projects
          </span>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
          {projects.map((project, i) => (
            <ProjectCard project={project} index={i} />
          ))}

          {/* Single nested ANSYS entry: opens a landing page to pick either study */}
          {ansysProjects.length > 0 && (
            <a
              href={withBase("/projects/ansys")}
              class="reveal group relative flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-panel)] p-6 sm:p-7 transition-all duration-300 hover:border-[var(--border-strong)] hover:-translate-y-1"
              data-reveal-delay={String((projects.length % 2) * 80)}
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-sm" style={`color: ${accent}`}>
                  {String(projects.length + 1).padStart(2, "0")}
                </span>
                <span class="font-mono text-xs uppercase tracking-widest text-[var(--text-faint)]">
                  {siteConfig.ansysNote}
                </span>
              </div>

              <h3 class="mt-4 text-xl sm:text-2xl font-semibold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
                ANSYS Engineering Projects
              </h3>

              <p class="mt-3 text-[15px] leading-relaxed text-[var(--text-muted)] flex-1">
                Two CFD studies in ANSYS Fluent: a turbulent pipe flow
                validation and a Cessna 172 airfoil analysis. Open to explore
                either one.
              </p>

              <div class="mt-6 flex items-center justify-between border-t border-[var(--border)] pt-4">
                <div class="flex flex-wrap gap-1.5">
                  {["ANSYS Fluent", "CFD", "Turbulence Modeling"].map((s) => (
                    <span class="font-mono text-[11px] px-2 py-1 rounded bg-[var(--bg-panel-2)] text-[var(--text-muted)]">
                      {s}
                    </span>
                  ))}
                </div>
                <span class="flex items-center gap-1.5 font-mono text-xs text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors whitespace-nowrap">
                  {ansysProjects.length} projects
                  <svg
                    class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M7 17L17 7M17 7H7M17 7v10"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}
