---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectChart from "../../components/ProjectChart.astro";
import ModelViewer from "../../components/ModelViewer.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import { siteConfig } from "../../config";
import { withBase } from "../../lib/base";

export function getStaticPaths() {
  // Main engineering projects + ANSYS coursework projects both get pages.
  // "next" cycles within each group so ANSYS pages stay nested together.
  const make = (list: any[], isAnsys: boolean) =>
    list.map((project, index) => ({
      params: { slug: project.slug },
      props: { project, next: list[(index + 1) % list.length], isAnsys },
    }));
  return [
    ...make(siteConfig.projects, false),
    ...make(siteConfig.ansysProjects, true),
  ];
}

const { project, next, isAnsys } = Astro.props;
const accent = siteConfig.accentColor;
const backHref = isAnsys ? withBase("/projects/ansys") : withBase("/#work");
const backLabel = isAnsys ? "ANSYS projects" : "All work";

const isTeam = Boolean(project.team && project.team.length);
const approachLabel = isTeam ? "The design" : "What I did";

// Explicit section numbers (order is fixed): Problem, Approach,
// [My contributions if team], Outcome.
const numProblem = "01";
const numApproach = "02";
const hasContrib = Boolean(project.myContributions && project.myContributions.length);
const numContrib = hasContrib ? "03" : null;
const numResult = hasContrib ? "04" : "03";
---

<BaseLayout
  title={`${project.name} · ${project.org}`}
  description={project.summary}
>
  <Header />

  <main class="px-5 sm:px-8 pt-28 pb-20">
    <article class="max-w-3xl mx-auto">
      <!-- Back -->
      <a
        href={backHref}
        class="inline-flex items-center gap-2 font-mono text-sm text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {backLabel}
      </a>

      <!-- Header -->
      <header class="mt-8 reveal">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-widest text-[var(--text-faint)]">
          <span style={`color:${accent}`}>{project.org}</span>
          <span>·</span>
          <span>{project.role}</span>
          <span>·</span>
          <span>{project.dateRange}</span>
        </div>
        <h1 class="mt-4 text-4xl sm:text-6xl font-bold text-[var(--text)]">
          {project.name}
        </h1>
        <p class="mt-5 text-lg sm:text-xl text-[var(--text-muted)] leading-relaxed">
          {project.summary}
        </p>

        {
          isTeam && (
            <p class="mt-5 text-sm text-[var(--text-faint)] leading-relaxed">
              <span class="font-mono uppercase tracking-wider">
                Team of {project.team!.length}:{" "}
              </span>
              {project.team!.map((member, i) => (
                <span>
                  <span
                    class={member === siteConfig.name ? "text-[var(--text)]" : ""}
                  >
                    {member}
                    {member === siteConfig.name ? " (me)" : ""}
                  </span>
                  {i < project.team!.length - 1 ? ", " : ""}
                </span>
              ))}
              {project.advisor && (
                <span>
                  {" "}
                  · Advisor: {project.advisor}
                </span>
              )}
            </p>
          )
        }
      </header>

      <!-- Metrics band -->
      {
        project.metrics?.length > 0 && (
          <div class="reveal mt-10 grid grid-cols-2 sm:grid-cols-3 gap-px rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--border)]">
            {project.metrics.map((m) => (
              <div class="bg-[var(--bg-panel)] p-5">
                <div class="font-mono text-2xl sm:text-3xl font-bold" style={`color:${accent}`}>
                  {m.value}
                </div>
                <div class="mt-1 font-mono text-[11px] uppercase tracking-wider text-[var(--text-faint)]">
                  {m.label}
                </div>
              </div>
            ))}
          </div>
        )
      }

      <!-- 3D model (Endless Garden only) -->
      {
        project.hasModel && (
          <div class="mt-12">
            <ModelViewer />
          </div>
        )
      }

      <!-- Context (team/background framing) -->
      {
        project.context && (
          <div class="reveal mt-12 border-l-2 pl-5" style={`border-color:${accent}`}>
            <p class="font-mono text-xs uppercase tracking-widest text-[var(--text-faint)] mb-2">
              Context
            </p>
            <p class="text-[17px] text-[var(--text-muted)] leading-relaxed">
              {project.context}
            </p>
          </div>
        )
      }

      <!-- Problem -->
      <section class="reveal mt-14">
        <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--text-faint)] flex items-center gap-3">
          <span style={`color:${accent}`}>{numProblem}</span> The problem
        </h2>
        <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed">
          {project.problem}
        </p>
      </section>

      <!-- Approach -->
      <section class="reveal mt-12">
        <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--text-faint)] flex items-center gap-3">
          <span style={`color:${accent}`}>{numApproach}</span> {approachLabel}
        </h2>
        <ul class="mt-5 space-y-4">
          {
            project.approach.map((step, i) => (
              <li class="flex gap-4">
                <span class="font-mono text-sm shrink-0 mt-0.5" style={`color:${accent}`}>
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p class="text-[17px] text-[var(--text-muted)] leading-relaxed">
                  {step}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- My contributions (team projects) -->
      {
        hasContrib && (
          <section class="reveal mt-12">
            <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--text-faint)] flex items-center gap-3">
              <span style={`color:${accent}`}>{numContrib}</span> My contributions
            </h2>
            <ul class="mt-5 space-y-3">
              {project.myContributions!.map((c) => (
                <li class="flex gap-3 text-[17px] text-[var(--text)] leading-relaxed">
                  <span class="mt-2.5 w-1.5 h-1.5 rounded-full shrink-0" style={`background-color:${accent}`} aria-hidden="true" />
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Chart (if any) -->
      {
        project.chart && (
          <div class="mt-12">
            <ProjectChart type={project.chart} />
          </div>
        )
      }

      <!-- Result -->
      <section class="reveal mt-12">
        <h2 class="font-mono text-sm uppercase tracking-widest text-[var(--text-faint)] flex items-center gap-3">
          <span style={`color:${accent}`}>{numResult}</span> Outcome
        </h2>
        <ul class="mt-5 space-y-3">
          {
            project.result.map((r) => (
              <li class="flex gap-3 text-[17px] text-[var(--text)] leading-relaxed">
                <span class="mt-2.5 w-1.5 h-1.5 rounded-full shrink-0" style={`background-color:${accent}`} aria-hidden="true" />
                <span>{r}</span>
              </li>
            ))
          }
        </ul>

        {
          project.note && (
            <p class="mt-6 rounded-lg border border-[var(--border)] bg-[var(--bg-panel)] p-5 text-[15px] text-[var(--text-muted)] leading-relaxed">
              <span class="font-mono text-xs uppercase tracking-wider" style={`color:${accent}`}>
                Note:{" "}
              </span>
              {project.note}
            </p>
          )
        }
      </section>

      <!-- Gallery -->
      {
        project.images && project.images.length > 0 && (
          <div class="mt-12">
            <ProjectGallery images={project.images} />
          </div>
        )
      }

      <!-- Next project -->
      <nav class="reveal mt-16 pt-8 border-t border-[var(--border)] flex items-center justify-between gap-4">
        <span class="font-mono text-xs uppercase tracking-widest text-[var(--text-faint)]">
          Next
        </span>
        <a
          href={withBase(`/projects/${next.slug}`)}
          class="group text-right"
        >
          <span class="block text-lg font-semibold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors">
            {next.name} →
          </span>
          <span class="font-mono text-xs text-[var(--text-faint)]">{next.org}</span>
        </a>
      </nav>
    </article>
  </main>

  <Footer />
</BaseLayout>
